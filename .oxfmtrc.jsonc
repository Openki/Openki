{
  "$schema": "node_modules/oxfmt/configuration_schema.json",
  "sortPackageJson": false,
  "ignorePatterns": [
    // Ignore artifacts
    ".meteor/",
    "node_modules/",
    "packages/",
    // i18next generated types for resources
    "types/resources.d.ts",

    // Preserve formatting of Blaze templates for readability
    // NOTE: These ignore rules can be removed after migrating away from Blaze and `iron:router`.
    "*.html",
  ],
}
