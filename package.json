  "devDependencies": {
    "@babel/preset-env": "7.28.3",
    "@eslint/js": "9.32.0",
    "@types/bootstrap": "5.2.10",
    "@types/bootstrap-datepicker": "1.10.0",
    "@types/es6-promisify": "6.0.4",
    "@types/jquery": "3.5.16",
    "@types/leaflet": "1.9.21",
    "@types/lodash-es": "4.17.12",
    "@types/medium-editor": "5.0.8",
    "@types/meteor-mdg-validation-error": "0.5.4",
    "@types/mime-types": "3.0.1",
    "@types/node-schedule": "2.1.8",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@types/seedrandom": "3.0.8",
    "@types/select2": "4.0.57",
    "@types/tinycolor2": "1.4.6",
    "@types/uuid": "10.0.0",
    "autoprefixer": "10.5.2",
    "cypress": "15.18.0",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "i18next-parser": "9.3.0",
    "postcss": "8.5.16",
    "postcss-load-config": "6.0.1",
    "prettier": "3.9.4",
    "start-server-and-test": "3.0.11",
    "stylelint": "17.14.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1"
  },
  "scripts": {
    "dev:startup": "npm run extract-translations && npm run type-check",
    "debug": "npm run dev:startup && npm run debug:dev",
    "debug:dev": "meteor --inspect --settings settings/dev.json",
    "debug:ssl": "npm run dev:startup && OPENKI_LOCALHOST_SSL=1 meteor --extra-packages storyteller:ssl --inspect --settings settings/dev.json",
    "test:ui": "start-test 'npm run test:env' :3000 'cypress open --e2e --browser electron'",
    "test": "start-test 'npm run test:env' :3000 'cypress run'",
    "test:ci": "WAIT_ON_TIMEOUT=600000 start-test 'npm run test:env -- --once' :3000 'cypress run --record'",
    "test:env": "BABEL_ENV=test DISABLE_REACT_FAST_REFRESH=1 meteor --settings settings/ci.json --port 3000",
    "lint": "eslint . && stylelint '**/*.scss' && prettier --check '**/*.{ts,tsx,scss,json*,js,mjs}'",
    "lint:fix": "eslint . --quiet --fix && stylelint '**/*.scss' --fix && prettier --write --list-different '**/*.{ts,tsx,scss,json*,js,mjs}'",
    "reset": "meteor reset --db && rm -rf node_modules && meteor npm install --verbose",
    "type-check": "meteor lint && tsc",
    "extract-translations": "rm -f imports/startup/both/i18n/en.json && npx i18next --silent"
  },
  "meteor": {
    "modern": {
      "transpiler": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/Openki/Openki.git"
  },
  "browserslist": [
    "defaults",
    "> 0.2%"
  ],
  "keywords": [
    "education",
    "self-organization",
    "calendar",
    "community"
  ],
  "author": "Openki-devs",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://gitlab.com/Openki/Openki/issues"
  },
  "homepage": "https://about.openki.net"
}
