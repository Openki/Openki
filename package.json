    "@types/bootstrap-datepicker": "1.10.1",
    "@types/es6-promisify": "6.0.4",
    "@types/jquery": "3.5.16",
    "@types/leaflet": "1.9.22",
    "@types/lodash-es": "4.17.12",
    "@types/medium-editor": "5.0.8",
    "@types/meteor-mdg-validation-error": "0.5.4",
    "@types/mime-types": "3.0.1",
    "@types/node-schedule": "2.1.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/seedrandom": "3.0.8",
    "@types/tinycolor2": "1.4.6",
    "@types/uuid": "10.0.0",
    "autoprefixer": "10.6.1",
    "core-js": "3.51.0",
    "cypress": "16.2.0",
    "i18next-parser": "9.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "postcss": "8.5.31",
    "postcss-load-config": "6.0.1",
    "start-server-and-test": "3.0.13",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tinyexec": "1.3.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev:startup": "npm run extract-translations && npm run type-check",
    "debug": "npm run dev:startup && npm run debug:dev",
    "debug:dev": "meteor --inspect --settings settings/dev.json",
    "debug:ssl": "npm run dev:startup && OPENKI_LOCALHOST_SSL=1 meteor --extra-packages storyteller:ssl --inspect --settings settings/dev.json",
    "test:ui": "start-test 'npm run test:env' :3000 'cypress open --e2e'",
    "test": "start-test 'npm run test:env' :3000 'cypress run'",
    "test:ci": "WAIT_ON_TIMEOUT=600000 start-test 'npm run test:env -- --once' :3000 'cypress run --record'",
    "test:env": "BABEL_ENV=test DISABLE_REACT_FAST_REFRESH=1 meteor --settings settings/ci.json --port 3000",
    "lint": "oxlint --report-unused-disable-directives && stylelint '**/*.scss' && oxfmt --check '**/*.{ts,tsx,scss,json*,js,md}'",
    "lint:fix": "oxlint --fix && stylelint '**/*.scss' --fix && echo 'Formatting and applying fixes...' && oxfmt --write '**/*.{ts,tsx,scss,json*,js,md}'",
    "reset": "meteor reset --db && rm -rf node_modules && meteor npm install --verbose",
    "type-check": "echo 'Linting and checking types...' && meteor lint && tsc",
    "extract-translations": "echo 'Extracting translations...' && rm -f imports/startup/both/i18n/en.json && npx i18next --silent"
  },
  "meteor": {
    "modern": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/Openki/Openki.git"
  },
  "browserslist": [
    "defaults",
    "> 0.2%"
  ],
  "keywords": [
    "education",
    "self-organization",
    "calendar",
    "community"
  ],
  "author": "Openki-devs",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://gitlab.com/Openki/Openki/issues"
  },
  "homepage": "https://about.openki.net"
}
