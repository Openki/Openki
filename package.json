  "scripts": {
    "dev:startup": "npm run extract-translations && npm run type-check:dev",
    "debug": "npm run dev:startup && npm run debug:dev",
    "debug:dev": "meteor --inspect --settings settings/dev.json",
    "debug:ssl": "npm run dev:startup && ROOT_URL=https://localhost:3443 OPENKI_LOCALHOST_SSL=1 meteor --inspect --settings settings/local.json --port 3000",
    "test:ui": "start-test 'npm run test:env' :3000 'cypress open --e2e'",
    "test": "start-test 'npm run test:env' :3000 'cypress run'",
    "test:ci": "WAIT_ON_TIMEOUT=600000 start-test 'npm run test:env -- --once' :3000 'cypress run --record'",
    "test:env": "SWC_ENV=test DISABLE_REACT_FAST_REFRESH=1 meteor --settings settings/ci.json --port 3000",
    "lint": "oxlint --report-unused-disable-directives && stylelint --cache --cache-location .temp/.stylelintcache '**/*.scss' && oxfmt --check '**/*.{ts,tsx,scss,json*,js,md}'",
    "lint:fix": "oxlint --fix && stylelint --cache --cache-location .temp/.stylelintcache '**/*.scss' --fix && echo 'Formatting and applying fixes...' && oxfmt --write '**/*.{ts,tsx,scss,json*,js,md}'",
    "reset": "meteor reset --db && rm -rf node_modules && meteor npm install --verbose",
    "type-check": "meteor types && i18next-cli types --quiet && echo 'Checking types...' && tsc",
    "type-check:dev": "meteor types && i18next-cli types --quiet && echo 'Checking types...' && tsc --noUnusedLocals false --noUnusedParameters false",
    "extract-translations": "echo 'Extracting translations...' && i18next-cli extract --sync-primary --with-types --quiet",
    "watch-translations": "i18next-cli extract --sync-primary --with-types --watch",
    "lint:translations": "i18next-cli lint"
  },
