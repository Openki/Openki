/*
 * This file describes all configurations and customization options. Remove the
 * comment at the end of the line to make it work or start from a copy of the
 * file "productive-basic.json in the same folder
 */

{
  /*
   * User administrator accounts
   * Default: []
   */
  "admins": ["greg"],

  /*
   * Pseudo-Random Number Generator. Use "static" as value to use static seed
   * for test data. Result: After test data generation, entity ids, amount of
   * events, comment content, region assignment of groups, etc will stay
   * identical. Except ids from users.
   * Default: "" (random seed)
   */
  "prng": "",

  /*
   * Generates test data, is not needed for the production environment.
   * Default: false
   */
  "testdata": true,

  "public": {
    /* Default: "Hmmm" */
    "siteName": "Openki-clone",

    /*
     * The text top left at the logo
     * Default: ""
     */
    "siteStage": "beta",

    /*
     * Shows a banner saying that this is only for testing
     * Default: false
     */
    "testWarning": true,

    /*
     * The logo in the top left corner. Can be a logo from the `/public/logo/*` folder,
     * from our s3 file storage (must start with the "publicUrlBase" setting) or
     * a base64 encoded string.
     */
    "headerLogo": {
      "src": "openki-logo-web-2020.svg",
      "alt": "Openki Logo",
    },

    /*
     * The logo in the top left corner from the `/kiosk/events/` page. Can be a logo
     * from the `/public/logo/*` folder, from our s3 file storage (must start with
     * the "publicUrlBase" setting) or a base64 encoded string.
     */
    "headerLogoKiosk": {
      "src": "openki-logo-kiosk-2020.svg",
      "alt": "Openki Logo",
    },

    /* The default image used for avatars (color is changed using the CSS filter 'hue-rotate'). */
    "avatarLogo": {
      "src": "openki-logo-web-avatar-2020.svg",
      /* The value can be a string or a object with key & values for every language eg. `{ "en": "...", "de": "...", ... }` */
      "alt": "User Avatar",
    },

    /*
     * The image to be shown in social media. Can be a logo from the `/public/logo/*` folder or
     * from our s3 file storage (must start with the `"publicUrlBase"` setting).
     */
    "ogLogo": {
      "src": "openki_logo_2018.png",
    },

    /*
     * Can be a logo from the `/private/*` folder, from our s3 file storage (must
     * start with the `"publicUrlBase"` setting) or a base64 encoded string.
     */
    "emailLogo": "emails/openki.png",

    /* Theming the ui */
    "theme": {
      /* Default: #38829c */
      "brand": "#38829c",
    },

    /* IDs of the tenants that should be displayed publicly, choose at least one */
    "publicTenants": ["8410c099a7"],

    "regionSelection": {
      /*
       * The minimum number of regions displayed in the Regions selection.
       * Default: 5
       */
      "minNumber": 5,
      /*
       * A link to a page that explains regions, if not set then none link is shown.
       * The value can be a string or a object with key & values for every language
       * eg. `{ "en": "...", "de": "...", ... }`
       */
      "aboutLink": {
        "en": "/info/faq#what-is-an-openki-region",
        "de": "...",
      },
    },

    /*
     * A link to a page that give instructions how to translate.
     * Default: "https://gitlab.com/Openki/Openki/-/wikis/translation"
     * Note: This setting can be a string or a object with key & values for every language
     * eg. `{ "en": "...", "de": "...", ... }`
     */
    "i18nHelpLink": "https://gitlab.com/Openki/Openki/-/wikis/translation",

    /* Define alternative translation files */
    "i18nMapping": {
      "de": "de-zuerich-lernt",
    },

    "matomo": {
      "url": "https://analytics.mydomain.com/",
      "site": 1, // Matomo id
    },

    /*
     * Show only indicative prices (DE: Richtpreise)
     * Default: true
     */
    "pricePolicyEnabled": true,

    /*
     * Ask user to receive newsletter on account registration.
     * Default: true
     */
    "askNewsletterConsent": true,

    /*
     * Should a reminder be sent by default or not.
     * Default: true
     */
    "sendReminderPreset": true,

    "feature": {
      /* Toggle visibility of login services */
      "login": {
        /* Default: true */
        "email": true,
        /* Default: false */
        "google": false,
        /* Default: false */
        "facebook": false,
        /* Default: false */
        "github": false,
        /* Default: false */
        "c3": false,
      },

      /*
       * Allow user without password.
       * Default: false
       */
      "visitorUser": true,

      /*
       * Allow rsvp with +1 / for two seats.
       * Default: false
       */
      "rsvpWithCompanions": true,

      /*
       * Allow to edit whether to remind or not.
       * Default: true
       */
      "sendReminderIsEditable": true,

      /*
       * Show a "empty" group box to propose a new group.
       * Default: true
       */
      "proposeGroupBox": true,

      /*
       * Disable the creation of 2dSphere indexes for db entities, this allow to
       * save non geo location in db, used for CustomMapConfig.
       * Default: false
       */
      "disable2dSphereForLocations": false,

      /*
       * Which social media buttons should be displayed, when web share api is not
       * supported from the browser.
       */
      "socialMediaButtons": [
        "bluesky",
        "facebook",
        "fediverse",
        "hackernews",
        "linkedin",
        "mastodon",
        "odnoklassniki",
        "pinterest",
        "pocket",
        "reddit",
        "teams",
        "telegram",
        "tumblr",
        "twitter",
        "viber",
        "vkontakte",
        "whatsapp",
        "copy-url",
        "email",
      ],
    },

    "nav": {
      /*
       * Target link when clicking on the logo
       * Default: "/"
       */
      "brandLink": "/",

      /*
       * Show/hide find/search item in navbar
       * Default: true
       */
      "search": true,

      /*
       * Show/hide propose item in navbar
       * Default: true
       */
      "proposeGroup": true,

      /*
       * Show/hide calendar item in navbar
       * Default: true
       */ "calendar": true,

      /* Default: [] */
      "customEntries": [
        {
          "link": "https://about.openki.net/",
          /* icon from fontawesome free */
          "icon": "fa-solid fa-pen",
          /*
           * The text from the link.
           * The value can be a translation key from i18next defined in code, a string or a object
           * with key & values for every language eg. `{ "en": "Edit", "de": "Bearbeiten", ... }`
           */
          "text": "...",

          /*
           * Text from the link. The value is a translation key from i18next it must be
           * defined in code
           * Deprecated: use "text" field instead (May 2026)
           */
          "key": "...",
        },
      ],
    },

    /*
     * Standard for all regions, can be overwritten if the "dashboard" property is
     * set in the region, if not set, the ‘find’ page is displayed
     * Default: undefined
     */
    "regionDashboardDefault": [
      {
        /*
         * The entity to show: "group", "groupWithoutPropose", "event", "organization",
         * "eventsMap", "propose" are supported
         */
        "entity": "",
        /*
         * Title to display over the row. The value can be a translation key from
         * i18next defined in code, a string or a object with key & values for
         * every language eg. `{ "en": "...", "de": "...", ... }`
         */
        "title": "",
        /*
         * Query how the data should be filtered and sorted, all options and filters
         * can be found in the wiki, can be an empty string "". The entities are
         * filtered by region.
         */
        "query": "",
        /* Overwrite the standard showAll button (Optional) */
        "showAll": {
          /* The target to which the button links. */
          "link": "",
          /*
           * The text to display. The value can be a translation key from i18next
           * defined in code, a string or a object with key & values for every language
           * eg. `{ "en": "...", "de": "...", ... }`
           */
          "text": "",
        },
      },
    ],

    /*
     * Standard for all organizations, can be overwritten if the "dashboard" property
     * is set in the organization, if not set, the "find" page is displayed.
     * Default: undefined
     */
    "organizationDashboardDefault": [
      {
        /*
         * The entity to show: "group", "groupWithoutPropose", "event", "organization",
         * "eventsMap", "propose" are supported
         */
        "entity": "",
        /*
         * Title to display over the row. The value can be a translation key from i18next defined
         * in code, a string or a object with key & values for every language
         * eg. `{ "en": "...", "de": "...", ... }`
         */
        "title": "",
        /*
         * Query how the data should be filtered and sorted, all options and filters can be found in
         * the wiki, can be an empty string "". The entities are filtered by region and group.
         */
        "query": "",
        /* Overwrite the standard showAll button (optional) */
        "showAll": {
          /* The target to which the button links. */
          "link": "",
          /*
           * The text to display. The value can be a translation key from i18next defined in code,
           * a string or a object with key & values for every language
           * eg. `{ "en": "...", "de": "...", ... }`
           */
          "text": "",
        },
      },
    ],

    /* Default roles for all regions. Can be overwritten per region by setting the `Region.roles` property */
    "defaultRoles": [
      {
        /* A unique name for the role, e.g. "team". This key is used to connect the role with i18n strings */
        "type": "participant",
        /* Icon class string from font-awesome ex: "fa-solid fa-bullhorn" */
        "icon": "fa-solid fa-thumbs-up",
        /*
         * The role appears as "proposed only" in the member list.
         * Default: false
         */
        "proposal": false,
        /*
         * The role is always added to the group on creation.
         * Default: false
         */
        "preset": true,
        /*
         * The role can be edited (added/removed to the group) after a group has been created
         * by the editors of a group.
         * Default: false
         */
        "editable": false,
        /**
         * Each role can have custom translations.
         * You only need to include the keys you want to change.
         * If a key is not defined in your overrides, the default translation from
         * `i18n/roles/*.json` will be used instead.
         *
         * Below is a list of some useful keys.
         */
        "translations": {
          // In this case, only the short form will be using the custom translation

          /** A short label that appears next to the user or can be used in a text. */
          "short": {
            "en": "participant",
            "de": "teilnehmer",
            "sv": "deltagare",
          },

          /**
           * A short description, shown on group create/edit.
           *
           * Default: "{ROLE}"
           * Example: "a host that provides a place"
           */
          // description: { ... },

          /**
           * A call to action, shown on the button to subscribe as a role to a group.
           *
           * Default: "I can be {ROLE}"
           * Example: "I have a place to host this"
           */
          // subscribe: { ... },

          /**
           * A message, shown after a user has subscribe. `\n` can be used to add a linebreak.
           * The variable `{GUIDE}` can be used to show the link from the `groupGuideLink`
           * setting from `settings.json`.
           *
           * Default: ""
           * Example: "If not done already, please mention your experiences on the topic in your personal
           *          message.\n\n{GUIDE}"
           */
          // "group.firstSteps": { ... },

          /**
           * A message send to the coordination team, after a user has subscribe. `\n` can be used to
           * add a linebreak. The variable `{USER}` and `{GROUP}` are available.
           *
           * Default: "{USER} just joined {GROUP} as {ROLE}"
           * Example: "{USER} just joined {GROUP} as mentor\n\nIf you like them to collaborate feel free
           *          to contact them. You can give them rights to edit {GROUP} and make them part of the
           *          coordination team by clicking the megaphone next to their name."
           */
          // "notification.join.mail.intro": { ... },
        },
      },
      {
        "type": "mentor",
        "icon": "fa-solid fa-graduation-cap",
        "proposal": true,
        "preset": false,
        "editable": true,
      },
      {
        "type": "host",
        "icon": "fa-solid fa-house",
        "proposal": true,
        "preset": false,
        "editable": true,
      },
      {
        "type": "team",
        "icon": "fa-solid fa-bullhorn",
        "proposal": false,
        "preset": true,
        "editable": false,
      },
    ],

    /* Default: [] */
    "footerLinks": [
      {
        "link": "https://about.openki.net/",
        /*
         * The text from the link.
         * The value can be a translation key from i18next defined in code, a string or a object
         * with key & values for every language eg. `{ "en": "Edit", "de": "Bearbeiten", ... }`
         */
        "text": "footer.aboutOpenki",
        /**
         * Text that is shown on hover the link.
         * The value can be a translation key from i18next defined in code, a string or a object
         * with key & values for every language eg. `{ "en": "Edit", "de": "Bearbeiten", ... }`
         */
        "title": "navigation.footer.about.title",

        /**
         * Text from the link. The value is a translation key from i18next it must be
         * defined in code
         * Deprecated: use "text" field instead (May 2026)
         */
        "key": "footer.aboutOpenki",
        /**
         * text that is shown on hover the link
         * Deprecated: use "title" field instead (May 2026)
         */
        "title_key": "navigation.footer.about.title",
      },
      {
        "link": "/info/faq",
        "text": "FAQ",
      },
      {
        "link": "https://gitlab.com/Openki/Openki/",
        "text": "navigation.footer.powerdByOpenki",
        "title": "navigation.footer.codeOnGitLab",
      },
      {
        "link": "https://about.openki.net/privacy-policy/",
        "text": "main.privacyPolicy",
        "title": "main.privacyPolicy.tooltip",
      },
    ],

    /*
     * Text displayed in the registration form to link to the Privacy Policy and Terms and
     * Conditions. Can be markdown.
     * Default: undefined (not shown).
     * Note: This setting can be a string or a object with key & values for every language
     * eg. `{ "en": "...", "de": "...", ... }`
     */
    "dataProtectionLaw": "By continuing I accept the [Privacy Policy](https://about.openki.net/en/privacy-policy/) and [Terms of Service](https://about.openki.net/terms-and-conditions/)",

    /*
     * This setting can be a string or a object with key & values for every language
     * eg. `{ "en": "...", "de": "...", ... }`
     * Default: "/info/faq"
     */
    "faqLink": "/info/faq",

    /*
     * This setting can be a string or a object with key & values for every language
     * eg. `{ "en": "...", "de": "...", ... }`
     * Default: `{
                   en: "/info/faq#why-cant-i-charge-a-fixed-fee-as-a-mentor"
                 }`
     */
    "pricePolicyLink": "...",

    /*
     * This setting can be a string or a object with key & values for every language
     * eg. `{ "en": "...", "de": "...", ... }`
     * Default: `{
                   en: "https://about.openki.net/wp-content/uploads/2019/05/How-to-organize-my-first-Openki-course.pdf",
                   de: "https://about.openki.net/wp-content/uploads/2019/05/Wie-organisiere-ich-ein-Openki-Treffen.pdf",
                 }`
     */
    "groupGuideLink": "...",

    /*
     * This setting can be a string or a object with key & values for every language
     * eg. `{ "en": "...", "de": "...", ... }`
     * Default: "https://about.openki.net"
     */
    "aboutLink": "https://about.openki.net",

    /*
     * Contribution to the platform. A admin can set in the userprofile that a user has contributed.
     * This shows a icon next to the username. Remove this setting to disable this feature.
     */
    "contribution": {
      "icon": "fa-solid fa-heart",
      /* forbidden chars in username */
      "forbiddenChars": ["🖤", "💖", "💔", "💚", "💜", "❤️", "🧡", "💕", "💛", "💝"],
      /*
       * This setting can be a string or a object with key & values for every language
       * eg. `{ "en": "...", "de": "...", ... }`
       */
      "link": {
        "en": "https://about.openki.net/en/ueber-uns/spenden/",
        "de": "https://about.openki.net/ueber-uns/spenden/",
      },
    },

    /*
     * Max characters allowed for the description-field of groups.
     * Default: 15000
     */
    "groupDescriptionMax": 15000,

    /*
     * Max characters allowed for the description-field of events.
     * Default: 15000
     */
    "eventDescriptionMax": 15000,

    /*
     * Categories for groups, main and/or sub categories
     * Default: {}
     */
    "categories": {
      "sports": ["martialarts", "teamsport", "artistry"],
      "handicraft": [],
      "[categoryname]": ["subcategoryname1", "subcategoryname2"],
    },

    /* file storage (public part) */
    "s3": {
      "publicUrlBase": "https://984b.objectstorage.nineapis.ch/v1/AUTH_01234-xyz123/bucket-name",
    },
  },

  /*
   * Sender e-mail address in mails
   * Default: ""
   */
  "siteEmail": "",

  /* "Reply to" address in mails */
  "replyToEmail": "",

  /*
   * Sender and recipient address for "Report problem" function. The recipient is also
   * visible in e-mails sent to users.
   */
  "reporter": {
    /*
     * The e-mail address of the sender. All e-mail addresses can be plain "sender@server.com"
     * or formatted "Sender Name <sender@server.com>"
     * Default: "reporter@mail.openki.net"
     */
    "sender": "pingpong@mail.openki.net",
    /*
     * Comma separated list of recipients e-mail addresses that will appear on the "To:" field
     * Default: "admins@openki.net"
     */
    "recipient": "badabuff@openki.net",
  },

  /**
   * How many private messages each user can send to different users per hour.
   * If the limit is reached, the messages get blocked and an alert to is sent
   * to the reporter.recipient address.
   * Unless a explicit number is set this defaults to `0` which means no limit.
   * Default: 0
   */
  "allowedPrivateMessagesPerHour": 30,

  /*
   * Tells robots/crawlers whether to index the website or not
   * Default: true
   */
  "robots": false,

  /*
   * Tells robots/crawlers not to index user profiles (`/user/*`)
   * Default: false
   */
  "hideProfiles": false,

  /*
   * Print the log on the server in the console, usually only for development
   * Default: false
   */
  "printLog": false,

  /* OAuth */
  "service": {
    "facebook": {
      "appId": "567890",
      "secret": "123abcd",
    },
    "github": {
      "clientId": "1234cdef",
      "secret": "abcd1234",
    },
    "google": {
      "clientId": "01234-xyz123.apps.googleusercontent.com",
      "secret": "XYz_123",
    },
    "c3": {
      "clientId": "",
      "secret": "",
      "authorizeUrl": "",
      "tokenUrl": "",
      "userInfoUrl": "",
    },
  },

  /* file storage, private part */
  "s3": {
    "region": "nine-cz42",
    "bucketEndpoint": "https://984b.objectstorage.nineapis.ch/bucket-name",
    "accessKeyId": "abcd1234",
    "secretAccessKey": "123abcd",
  },

  /*
   * Maximum number of entities that the api returns. If the parameter `limit`
   * is not set in the URL, the API always returns 100 entities whatever this
   * setting is set to.
   * Default: 100
   */
  "apiMaxLimit": 100,

  /*
   * How many hours back notification e-mails should be sent after the server was down.
   * This helps when there was a big problem with the server to not spam people.
   * Default: 72
   */
  "notificationGracePeriodHours": 72,

  /* Delete entries from the log or remove critical information. The log can be viewed via `.../log` */
  "scrub": [
    {
      "name": "scrub client-errors",
      "comment": "client-side errors may contain sensitive data, drop them quickly",
      "grace": 7, // "grace": 7 means: After 7 days it will be removed
      "select": {
        "tr": "clientError",
      },
      "remove": true,
    },
    {
      "name": "drop resume-logins",
      "comment": "Resume-Logins are not very interesting",
      "grace": 7,
      "select": {
        "tr": "Login.Success",
        "body": {
          "type": "resume",
        },
      },
      "remove": true, // "remove": true means: The whole entry is removed
    },
    {
      "name": "scrub logins",
      "comment": "We want to remember user logins but not the details",
      "grace": 8,
      "select": {
        "tr": "Login.Success",
      },
      "unset": ["connection", "username"], // "unset": [ "field1", "field2", ... ] means: Individual fields are removed
    },
    {
      "name": "drop send-results",
      "comment": "We keep notification send results for troublehooting",
      "grace": 61,
      "select": {
        "tr": "Notification.SendResult",
      },
      "remove": true,
    },
  ],

  /*
   * That web pages are pre-rendered for webcrawlers on the server side so that
   * no client code has to be executed. See: https://guide.meteor.com/deployment.html#seo
   */
  "PrerenderIO": {
    "serviceUrl": "http://localhost:3033/",
    "token": "mytoken",
  },
}
