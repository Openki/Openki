FROM node:24-trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  # Install system dependencies
  && apt-get install -y --no-install-recommends curl ca-certificates dumb-init build-essential \
  # Install Meteor
  && curl -fsSL https://install.meteor.com/?release=$METEOR_VERSION | sh \
  # Reduce container size
  && rm -rf /tmp/* /var/lib/apt/lists/* /var/cache/*

# Create app directory and set permissions
WORKDIR /app
RUN chown -R node:node ./ \
  && ls -la /app/.meteor

ENV METEOR_ALLOW_SUPERUSER=true

USER node

# Only copy what's needed to install dependencies.
# Source code and other files should be provided via the bind mount,
# which is defined in `docker-compose.dev.yml`.
# This approach enables caching for the this layer while making app code editable.
COPY --chown=node:node package*.json /app/
COPY --chown=node:node ./.meteor /app/.meteor/

# RUN echo 2 && exit 1

# TODO: Temporarily log as much as possible until everything works as expected
RUN meteor npm ci --loglevel silly

EXPOSE 3000 9229

# TODO: Once the app starts as expected, we should run the normal `debug` script defined in package.json
# to start the other dev scripts as expected. For example to extract translations and check types.
# Run with dumb-init to not start node with PID=1, since Node.js was not designed to run as PID 1
CMD ["dumb-init", "meteor", "--inspect=0.0.0.0:9229", "--settings", "settings/docker-dev.json"]
