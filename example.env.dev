# Local overrides for docker-compose.dev.yml.
#
# Usage:
#   cp example.env.dev .env.dev
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up --build
#
# Everything below is optional - docker-compose.dev.yml already has working
# defaults. Uncomment/edit only what you need to change on your machine.

# --- App ---
# APP_PORT=3000
# APP_INSPECT_PORT=9229
# ROOT_URL=http://localhost:3000

# --- MongoDB ---
# Default is 4.4, because MongoDB 8.x refuses to start on Linux kernel 6.19+
# (TCMalloc/glibc rseq ABI incompatibility, see MongoDB SERVER-121912). If your
# host doesn't hit that, you can try matching production's docker-compose.yml:
# MONGO_IMAGE=mongodb/mongodb-community-server:8.0-ubuntu2204-slim
# MONGO_PORT=27017

# --- Garage (S3) ---
# Change these if the default ports are already taken on your machine.
# GARAGE_S3_API_PORT=3900
# GARAGE_WEB_PORT=3902
# GARAGE_ADMIN_PORT=3903
