# Local overrides for docker-compose.local.yml.
#
# Usage:
#   cp example.env.local .env.local
#   docker compose --env-file .env.local -f docker-compose.local.yml up --build
#
# Everything below is optional - docker-compose.local.yml already has working
# defaults. Uncomment/edit only what you need to change on your machine.

# --- App ---
# APP_PORT=3000
# APP_INSPECT_PORT=9229
# ROOT_URL=http://localhost:3000

# --- MongoDB ---
# Default is 8.0.x to match the MongoDB version used in production.
#
# However, if you use a Linux kernel version between 6.19-7.0.11,
# then MongoDB 8.x might refuse to start because of a
# TCMalloc/glibc rseq ABI incompatibility, see MongoDB SERVER-121912.
# If your host has problems you can try using an older MongoDB version:
# MONGO_IMAGE=mongodb/mongodb-community-server:4.4-ubuntu2204-slim
# MONGO_PORT=27017

# --- Garage (S3) ---
# Change these if the default ports are already taken on your machine.
# GARAGE_S3_API_PORT=3900
# GARAGE_WEB_PORT=3902
# GARAGE_ADMIN_PORT=3903
