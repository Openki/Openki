FROM node:24-trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# NOTE: Try if the install can be done via npx instead

RUN apt-get update \
  # Install system dependencies
  && apt-get install -y --no-install-recommends curl ca-certificates build-essential just \
  # Install Meteor
  && curl -fsSL https://install.meteor.com/?release=$METEOR_VERSION | sh \
  # Reduce container size
  && rm -rf /tmp/* /var/lib/apt/lists/* /var/cache/*

# Create app directory and set permissions
WORKDIR /app

# TODO: Ideally remove this if possible since it's a huge security risk
ENV METEOR_ALLOW_SUPERUSER=true

EXPOSE 3000 9229

COPY ./docker/entrypoint.local.sh /entrypoint.sh
COPY ./docker/start.local.sh /start.local.sh

ENTRYPOINT ["/entrypoint.sh"]
