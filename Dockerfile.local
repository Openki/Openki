FROM node:24-trixie-slim

# Should match the version defined in `.meteor/release`
ARG METEOR_VERSION=3.5.4

# This removes the need for sudo access when running meteor commands in the container
ENV METEOR_NO_RELEASE_CHECK=true
# Disable Meteor telemetry
ENV DO_NOT_TRACK=1
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  # Install system dependencies
  && apt-get install -y --no-install-recommends curl ca-certificates build-essential just \
  # Install Meteor
  && curl -fsSL https://install.meteor.com/?release=$METEOR_VERSION | sh \
  # Reduce container size
  && rm -rf /tmp/* /var/lib/apt/lists/* /var/cache/*

WORKDIR /app

# TODO: Ideally remove this if possible since it's a huge security risk
ENV METEOR_ALLOW_SUPERUSER=true

EXPOSE 3000 9229

COPY ./docker/entrypoint.local.sh /entrypoint.sh
COPY ./docker/start.local.sh /start.local.sh

ENTRYPOINT ["/entrypoint.sh"]
