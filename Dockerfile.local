# The Node.js major version should be the one supported by our current METEOR_VERSION
# See the changelog for more info: https://docs.meteor.com/history
FROM node:24-trixie-slim

USER node
WORKDIR /app

RUN npx "meteor@$METEOR_VERSION"

# Ensure the `meteor` binary is available in the path
RUN export PATH=/home/node/.meteor:$PATH

# RUN apt-get update && apt-get install -y curl

# Install the defined Meteor version. This should matach ./.meteor/release
# RUN curl https://install.meteor.com/?release=$METEOR_VERSION | sh

# Remove temporary packages like curl
# RUN apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false

# USER node
# WORKDIR /app

# Might be worth trying to explicit bind mounts in the container itself
# RUN --mount=type=cache,target=/root/.npm \
#     --mount=type=bind,source=package.json,target=package.json \
#     --mount=type=bind,source=package-lock.json,target=package-lock.json \
#   meteor npm ci

# Only copy what's needed to install dependencies.
# Source code and other files should be provided via the bind mount,
# which is defined in `docker-compose.dev.yml`.
# This approach enables caching for this layer while editing app code.
COPY --chown=node:node package*.json /app/
COPY --chown=node:node ./.meteor /app/.meteor/

# TODO: The core issue is that the meteor tool does not have access to the /app directory.
# TODO: Another error is that npm (or something else) fails with exit code 77.

# TODO: Temporarily log as much as possible until everything works as expected
RUN meteor npm ci --loglevel silly

EXPOSE 3000 9229

# TODO: Once the app starts as expected, we should run the normal `debug` script defined in package.json
# to start the other dev scripts as expected.
CMD ["meteor", "--inspect=0.0.0.0:9229", "--settings", "settings/docker-dev.json"]
