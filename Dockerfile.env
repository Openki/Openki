# Dev environment image for docker-compose.dev.yml.
#
# Unlike the production Dockerfile, this does NOT build a bundle. It just
# provides the Meteor toolchain with dependencies installed; the actual
# source is bind-mounted at runtime so Meteor's hot code reload keeps working
# and the Node inspector can attach for debugging.
FROM geoffreybooth/meteor-base:3.5

RUN useradd --create-home --shell /bin/sh -u 1001 meteor-app
WORKDIR /app

# Only copy what's needed to install dependencies.
# Source code and other files should be provided via the bind mount,
# which is defined in `docker-compose.dev.yml`.
# This approach enables caching for this layer while editing app code.
COPY package.json package-lock.json ./
COPY ./.meteor ./.meteor/

# Let the app user fully control the /app directory
RUN chown -Rh meteor-app:meteor-app /app
USER meteor-app

RUN meteor npm ci

EXPOSE 3000 9229

# TODO: Once the app starts as expected, we should run the normal `debug` script defined in package.json
# to start the other dev scripts as expected.
CMD ["meteor", "--inspect=0.0.0.0:9229", "--settings", "settings/docker-dev.json"]
