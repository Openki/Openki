# Dev environment image for docker-compose.dev.yml.
#
# Unlike the production Dockerfile, this does NOT build a bundle. It just
# provides the Meteor toolchain with dependencies installed; the actual
# source is bind-mounted at runtime so Meteor's hot code reload keeps working
# and the Node inspector can attach for debugging.
FROM geoffreybooth/meteor-base:3.5

WORKDIR /app

# Only copy what's needed to install dependencies, so this layer stays
# cached while editing app code. The full source arrives via the bind mount
# declared in docker-compose.dev.yml.
COPY package.json package-lock.json ./
COPY .meteor ./.meteor

RUN meteor npm ci

EXPOSE 3000 9229

CMD ["meteor", "--inspect=0.0.0.0:9229", "--settings", "settings/docker-dev.json"]
